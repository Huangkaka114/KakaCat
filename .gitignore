# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试与工具缓存 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# ---- 下载器运行期产物 ----
# 分片临时目录、拼接中间文件与未完成的输出
*.part
*.concat.txt
*.m3u8.tmp
_hls_tmp*/
# 分片临时目录默认建在输出目录下，下载到项目目录里时不该入库
hls_resume_*/
hls_segments_*/

# ---- 打包产物 ----
# exe、安装程序与构建中间产物（build/、dist/ 已在上面忽略）
# bin/ 是随包分发的第三方二进制（ffmpeg / mpv），几十 MB 且各有自己的许可，
# 不入库；要随包分发就用 packaging/build.py --bundle-tools 现拷
/bin/
packaging/resources/_preview.png

# ---- 程序自己的运行数据 ----
# 便携模式下程序会在自己目录里建 data/（临时文件、将来的日志与配置），
# 那是本机运行产物，不该入库
/data/

# ---- 本机开发约定 ----
# CLAUDE.md 是本机的开发约定说明，只服务本地工作流，不入库、不随仓库分发
CLAUDE.md

# ---- 编辑器与操作系统 ----
# JetBrains / PyCharm 的本机配置，因人而异，不入库
.idea/
.vscode/
# Claude Code 的工作目录（含 worktree，里面是整份仓库副本）
.claude/
.DS_Store
Thumbs.db
desktop.ini
